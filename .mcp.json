{
  "mcpServers": {
    "supabase": {
      "type": "http",
      "url": "http://127.0.0.1:54361/mcp"
    },
    "vercel": {
      "type": "http",
      "url": "https://mcp.vercel.com"
    },
    "sentry": {
      "type": "http",
      "url": "https://mcp.sentry.dev/mcp"
    },
    "spideryarn": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "tsx",
        "scripts/spideryarn-mcp.ts",
        "serve",
        "--site",
        "https://www.spideryarn.com"
      ]
    },
    "spideryarn-remote": {
      "type": "http",
      "url": "https://www.spideryarn.com/api/mcp"
    }
  }
}
