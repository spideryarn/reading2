{
  /* The node side: pipeline stages, the API, and the config files that run in
     the same process. Module resolution is nodenext because that is literally
     how these files run — tsx and node ESM — so a missing `.js` on a relative
     import is an error here rather than a crash the first time you run the
     stage. The client (src/web) is bundled by vite and uses Bundler
     resolution instead; see src/web/tsconfig.json. */
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ES2022"],
    "types": ["node"]
  },
  "include": [
    "src",
    "scripts",
    /* The production API. It runs the same way these do — node ESM, our own
       `.js`-suffixed relative imports — and it is the only copy of the server
       that users ever reach, so it is the last file that should go unchecked. */
    "api",
    /* evals/ runs the same way these do — tsx, node ESM — and reads the same
       artefacts, so it belongs to this project rather than to tests/. It is not
       part of the test suite: an eval calls a model and costs money. See
       evals/README.md. */
    "evals",
    "vite.config.ts",
    "vitest.config.ts",
    "drizzle.config.ts"
  ],
  "exclude": ["src/web"]
}
