{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build && npx vite build --config vite.api.config.ts",
  "outputDirectory": "dist",

  "regions": ["lhr1"],

  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  },

  "functions": {
    "api/**": {
      "maxDuration": 800,
      "includeFiles": "certs/**"
    }
  },

  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ],

  "rewrites": [
    {
      "source": "/read/:slug",
      "destination": "/api/index?__spy_read=:slug"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index?__spy_path=$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
