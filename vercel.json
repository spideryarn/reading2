{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build && npx vite build --config vite.api.config.ts",
  "outputDirectory": "dist",

  "regions": ["lhr1"],

  "functions": {
    "api/**": {
      "maxDuration": 300,
      "includeFiles": "certs/**"
    }
  },

  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index?__spy_path=$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
