{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",

  "regions": ["lhr1"],

  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  },

  "functions": {
    "api/**": {
      "maxDuration": 800,
      "includeFiles": "certs/**"
    }
  },

  "headers": [
    {
      "source": "/((?!(?:features|features/public-readable-sharing|pricing|changelog|help|privacy|contact|opensource)?$).*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ],

  "rewrites": [
    {
      "source": "/read/:slug",
      "destination": "/api/index?__spy_read=:slug"
    },
    {
      "source": "/.well-known/oauth-protected-resource/api/mcp",
      "destination": "/api/index?__spy_path=mcp/resource-metadata"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index?__spy_path=$1"
    },
    { "source": "/features", "destination": "/_pages/features.html" },
    { "source": "/features/public-readable-sharing", "destination": "/_pages/public-readable-sharing.html" },
    { "source": "/pricing", "destination": "/_pages/pricing.html" },
    { "source": "/changelog", "destination": "/_pages/changelog.html" },
    { "source": "/help", "destination": "/_pages/help.html" },
    { "source": "/privacy", "destination": "/_pages/privacy.html" },
    { "source": "/contact", "destination": "/_pages/contact.html" },
    { "source": "/opensource", "destination": "/_pages/opensource.html" },
    {
      "source": "/((?!api/).*)",
      "destination": "/shell.html"
    }
  ]
}
