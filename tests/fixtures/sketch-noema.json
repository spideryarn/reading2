      "id": "close1",
      "shape": "ellipse",
      "x": 230,
      "y": 1010,
      "w": 300,
      "h": 80,
      "text": "Recovering an embodied sense of self",
      "size": "md",
      "detail": "More breath than thought, more meat than machine \u2014 a return to what makes us us.",
      "block": "spya-zv36xq"
     },
