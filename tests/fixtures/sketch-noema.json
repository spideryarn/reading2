 "sketch": {
  "version": "sketch/1",
  "title": "Two Funnels, A Fork, A Loop",
  "caption": "A funnel of psychological temptations converges on 'pareidolia', a funnel of four technical arguments converges on 'functionalism is shaky', that uncertainty forks into two distinct ethical risks, and the close loops back to the opening question of what makes us us.",
  "scenes": [
   {
    "id": "overview",
    "title": "Overview",
    "height": 1150,
    "items": [
     {
      "kind": "node",
      "id": "op1",
      "shape": "ellipse",
      "x": 230,
      "y": 40,
      "w": 300,
      "h": 70,
      "text": "Does AI consciousness matter?",
      "size": "md",
      "detail": "With consciousness comes moral status, rights, and the risk of suffering \u2014 for AI and for us.",
      "block": "spya-e68t9h"
     },
     {
      "kind": "region",
      "x": 24,
      "y": 150,
      "w": 712,
      "h": 180,
      "style": "band",
      "label": "WHY WE'RE TEMPTED TO SEE IT",
      "tone": 1
     },
     {
      "kind": "node",
      "id": "bias1",
      "shape": "box",
      "x": 40,
      "y": 190,
      "w": 210,
      "h": 80,
      "text": "Human-centered biases",
      "size": "sm",
      "sub": "anthropocentrism, exceptionalism, anthropomorphism",
      "detail": "Three overlapping biases make us project mind onto anything humanlike.",
      "tone": 1,
      "block": "spya-cvaqgs"
     },
     {
      "kind": "node",
      "id": "bias2",
      "shape": "box",
      "x": 275,
      "y": 190,
      "w": 210,
      "h": 80,
      "text": "Fluent language feels human",
      "size": "sm",
      "detail": "Saying chatbots 'hallucinate' quietly implies they experience things.",
      "tone": 1,
      "block": "spya-k6fpme"
     },
     {
      "kind": "node",
      "id": "bias3",
      "shape": "box",
      "x": 510,
      "y": 190,
      "w": 210,
      "h": 80,
      "text": "Techno-hype & rapture dreams",
      "size": "sm",
      "detail": "Exponential growth and Promethean ambition make imminent machine minds feel inevitable.",
      "tone": 1,
      "block": "spya-cke6sj"
     },
     {
      "kind": "node",
      "id": "conv1",
      "shape": "hex",
      "x": 230,
      "y": 350,
      "w": 300,
      "h": 70,
      "text": "Pareidolia, not evidence",
      "size": "md",
      "detail": "Seeing consciousness in AI may be like seeing a face in a cinnamon bun.",
      "tone": 1,
      "block": "spya-k850tu"
     },
     {
      "kind": "region",
      "x": 24,
      "y": 470,
      "w": 712,
      "h": 170,
      "style": "band",
      "label": "WHY IT'S PROBABLY NOT THERE",
      "tone": 2
     },
     {
      "kind": "node",
      "id": "arg1",
      "shape": "box",
      "x": 34,
      "y": 510,
      "w": 150,
      "h": 90,
      "text": "Brains aren't computers",
      "size": "sm",
      "detail": "No clean software/hardware split exists in living neural tissue.",
      "tone": 2,
      "block": "spya-sk4su6"
     },
     {
      "kind": "node",
      "id": "arg2",
      "shape": "box",
      "x": 214,
      "y": 510,
      "w": 150,
      "h": 90,
      "text": "More than algorithms",
      "size": "sm",
      "detail": "Analogue, continuous, dynamical processes may matter beyond Turing computation.",
      "tone": 2,
      "block": "spya-affgsh"
     },
     {
      "kind": "node",
      "id": "arg3",
      "shape": "box",
      "x": 394,
      "y": 510,
      "w": 150,
      "h": 90,
      "text": "Life may be necessary",
      "size": "sm",
      "detail": "Consciousness may be tied to self-sustaining, living, metabolic processes.",
      "tone": 2,
      "block": "spya-e7jqx4"
     },
     {
      "kind": "node",
      "id": "arg4",
      "shape": "box",
      "x": 574,
      "y": 510,
      "w": 150,
      "h": 90,
      "text": "Simulating \u2260 creating",
      "size": "sm",
      "detail": "A simulated storm doesn't get anything wet; a simulated brain may not feel.",
      "tone": 2,
      "block": "spya-cqh5wq"
     },
     {
      "kind": "node",
      "id": "conv2",
      "shape": "hex",
      "x": 230,
      "y": 670,
      "w": 300,
      "h": 70,
      "text": "Functionalism looks shaky",
      "size": "md",
      "detail": "Four independent arguments converge, though none is a knock-down proof.",
      "tone": 2,
      "block": "spya-uzr60x"
     },
     {
      "kind": "node",
      "id": "unc",
      "shape": "note",
      "x": 230,
      "y": 780,
      "w": 300,
      "h": 70,
      "text": "Deep uncertainty remains",
      "size": "sm",
      "detail": "No one can say for sure what would create, or avoid, real machine consciousness.",
      "tone": 3,
      "block": "spya-yverz7"
     },
     {
      "kind": "node",
      "id": "eth1",
      "shape": "box",
      "x": 60,
      "y": 890,
      "w": 290,
      "h": 90,
      "text": "Don't deliberately create conscious AI",
      "size": "sm",
      "detail": "Doing so risks introducing new moral subjects and new suffering at scale.",
      "tone": 3,
      "block": "spya-e7fdmb"
     },
     {
      "kind": "node",
      "id": "eth2",
      "shape": "box",
      "x": 410,
      "y": 890,
      "w": 290,
      "h": 90,
      "text": "Conscious-seeming AI is already here",
      "size": "sm",
      "detail": "Illusory consciousness poses its own distinct, present-day ethical risks.",
      "tone": 3,
      "block": "spya-vs0vpj"
     },
