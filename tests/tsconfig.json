{
  /* The tests, which reach into both of the other two projects — a test file
     imports `../src/arc.js` and `../src/web/keynav.js` in the same breath — so
     this project needs the node types and the DOM libs together. Bundler
     resolution because vitest is what runs these.

     Before this existed the tests were checked by nothing at all: `npm test`
     runs them through vitest's transpile-only pipeline, which strips the types
     without looking at them. */
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    /* `vite/client` alongside `node`, because a test that imports a client
       module can pull in one that reads `import.meta.env` — src/web/lib/
       supabase.ts is the first. Without it that property does not exist on
       `ImportMeta` in this project, and the file typechecks under
       src/web/tsconfig.json (which has the types) while failing here. Same
       shape as the `@/` alias below: a third resolver with its own way of
       being wrong. */
    "types": ["node", "vite/client"],

    /* The same `@/` alias src/web/tsconfig.json declares, pointed at the same
       directory from here. A test that imports a component which imports a
       shadcn one — `tweets-page.test.ts` was the first — pulls `@/components/
       ui/button` into *this* project, where the alias did not exist, and the
       typecheck failed on a module vite and vitest both resolve perfectly
       well. Runtime already had it (vitest.config.ts); this is the third of
       the three resolvers that doc names. */
    "paths": { "@/*": ["../src/web/*"] }
  },
  /* The ambient declarations for html-encoding-sniffer and for
     @napi-rs/canvas/geometry.js live beside the modules that use them, and this
     project pulls those modules in without owning the directory they sit in —
     so name each one, or `src/fetch.ts` and `src/pdf.ts` are checked here with
     untyped imports they do not have anywhere else. Adding a `.d.ts` under
     `src/` is therefore two edits, and this project is the one that tells you
     so: it is the only one where the omission shows up. */
  "include": [
    ".",
    "../src/html-encoding-sniffer.d.ts",
    "../src/napi-canvas-geometry.d.ts"
  ],
  "exclude": []
}
