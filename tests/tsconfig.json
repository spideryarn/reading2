{
  /* The tests, which reach into both of the other two projects — a test file
     imports `../src/arc.js` and `../src/web/keynav.js` in the same breath — so
     this project needs the node types and the DOM libs together. Bundler
     resolution because vitest is what runs these.

     Before this existed the tests were checked by nothing at all: `npm test`
     runs them through vitest's transpile-only pipeline, which strips the types
     without looking at them. */
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  /* The ambient declaration for html-encoding-sniffer lives beside the module
     that uses it, and this project pulls that module in without owning the
     directory it sits in — so name it, or `src/fetch.ts` is checked here with
     an untyped import it does not have anywhere else. */
  "include": [".", "../src/html-encoding-sniffer.d.ts"],
  "exclude": []
}
