node_modules/
dist/
data/
output/
.DS_Store
# Every env file, not just the ones we happen to have. .env.prod holds the remote
# project's keys and .env.local the local stack's; a third one arrives the moment
# somebody tries something. The template is the one exception, and it is listed
# after the pattern because order decides: a negation before its pattern does
# nothing.
.env*
!.env.example
.vercel

# Built by vite.api.config.ts during the Vercel build. See vercel.json.
api-dist

# Where evals/pdf/bakeoff writes its results. Transcribed article prose, tens of
# megabytes of it, regenerated by spending money — the *numbers* worth keeping
# are committed under evals/pdf/baselines/ instead.
scratch-bakeoff

# scripts/run-codex.ts writes its activity log beside the answer it was asked
# for. Each is roughly a megabyte of whatever codex read along the way — file
# dumps, grep hits, and on 2026-08-27 every one of the five sitting here matched
# a scan for `sk-or-v1-`, `sb_secret_` and `ANTHROPIC_API_KEY=`. The review it
# produced belongs in git; the log of how it got there does not.
*.activity.log

# @playwright/mcp writes here when it runs with a non-isolated profile — traces,
# a user-data dir, whatever a session downloaded. It appeared in the box's
# checkout, not on any laptop, so it would only ever be committed by accident
# from over there.
.playwright-mcp/
