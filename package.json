    "pdfjs-dist": "^6.2.108",
    "pg": "8.23.0",
    "pg-connection-string": "^2.14.0",
    "pino": "^10.3.1",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "stripe": "22.6.1",
    "tailwind-merge": "^3.6.0",
    "undici": "^7.29.0"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.8",
    "@babel/types": "^7.29.8",
    "@biomejs/biome": "2.5.10",
    "@inquirer/prompts": "8.7.0",
    "@sentry/vite-plugin": "^5.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/table-core": "^8.21.3",
    "@types/d3-force": "^3.0.10",
    "@types/jsdom": "^30.0.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.2.0",
    "@types/pg": "8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vercel/nft": "^1.11.0",
    "@vitejs/plugin-react": "^6.1.0",
    "drizzle-kit": "0.31.10",
    "fake-indexeddb": "^6.2.5",
    "jscpd": "5.0.16",
    "knip": "6.32.2",
    "pino-pretty": "^13.1.3",
    "playwright-core": "1.62.1",
    "smol-toml": "1.8.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
