{
  "name": "spideryarn",
  "version": "1.0.0",
  "description": "AI-assisted reading that augments rather than replaces reading.",
  "private": true,
  "scripts": {
    "test": "vitest run",
    "worktree:setup": "tsx scripts/worktree-setup.ts",
    "worktree:sweep": "tsx scripts/worktree-sweep.ts",
    "worktree:check": "tsx scripts/worktree-check.ts",
    "lint": "biome lint --max-diagnostics=none .",
    "lint:fix": "biome lint --write --max-diagnostics=none .",
    "cycles": "biome lint --only=suspicious/noImportCycles .",
    "complexity": "biome lint --only=complexity/noExcessiveCognitiveComplexity --max-diagnostics=none .",
    "knip": "knip",
    "dupes": "jscpd src api scripts evals --min-lines 5 --min-tokens 50 --format typescript,tsx --reporters console",
    "check": "tsx scripts/check.ts",
    "check:staged-revert": "tsx scripts/check-staged-revert.ts",
    "deploy": "tsx scripts/deploy.ts",
    "count-lines": "tsx scripts/count-lines.ts",
    "cost": "tsx scripts/ai-cost.ts",
    "ingest": "tsx scripts/stage.ts ingest",
    "extract": "tsx scripts/stage.ts extract",
    "pdf:pass0": "tsx src/pdf.ts",
    "blocks": "tsx scripts/stage.ts blocks",
    "dev": "vite",
    "dev:pretty": "vite | pino-pretty",
    "live:spike": "tsx scripts/live-spike.ts",
    "build:client": "vite build",
    "build:api": "vite build --config vite.api.config.ts",
    "build": "npm run build:client && npm run build:api",
    "validate-tree": "tsx src/validate-tree.ts",
    "hierarchy:flatten": "tsx src/hierarchy-flatten.ts",
    "test:watch": "vitest",
    "hierarchy": "tsx scripts/stage.ts hierarchy",
    "eval:pdf-read": "tsx src/pdf-read.ts",
    "eval:hierarchy": "tsx evals/hierarchy-labels.ts",
    "eval:hierarchy-structure": "tsx evals/hierarchy-structure/run.ts",
    "eval:summaries": "tsx evals/summaries/run.ts",
    "eval:cost": "tsx evals/cost/run.ts",
    "eval:deepen": "tsx evals/deepen/run.ts",
    "eval:cost:interactions": "tsx evals/cost/interactions.ts",
    "typecheck": "tsx scripts/typecheck.ts",
    "db:generate": "tsx scripts/db-generate.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:check": "tsx scripts/db-check.ts",
    "db:chain": "drizzle-kit check",
    "db:seed-owner": "tsx scripts/db-seed-owner.ts",
    "db:seed-dev": "tsx scripts/db-seed-dev.ts",
    "db:reown": "tsx scripts/db-reown.ts",
    "db:admin-password": "tsx scripts/db-admin-password.ts",
    "stripe:setup": "tsx scripts/stripe-setup.ts",
    "stripe:check": "tsx scripts/stripe-check.ts",
    "setup": "tsx scripts/setup-local.ts",
    "db:export": "tsx scripts/db-export.ts",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "eval:caching": "tsx evals/prompt-caching.ts",
    "eval:reorder": "tsx evals/reorder-quality.ts",
    "eval:remember": "tsx evals/remember-stances.ts",
    "eval:quiz": "tsx evals/quiz.ts",
    "eval:embeddings": "tsx evals/embedding-retrieval.ts",
    "eval:dictation-vocab": "tsx evals/dictation/bench-vocabulary-sources.ts",
    "eval:dictation-gate": "tsx evals/dictation/gate-models.ts",
    "eval:dictation-models": "tsx evals/dictation/bench-models.ts",
    "typecheck:committed": "tsx scripts/typecheck-committed.ts"
  },
  "keywords": [],
