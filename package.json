    "@sentry/core": "^10.71.0",
    "@sentry/node-core": "^10.71.0",
    "@sentry/react": "^10.71.0",
    "@supabase/supabase-js": "^2.112.4",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-force": "^3.0.0",
    "dompurify": "^3.4.14",
    "drizzle-orm": "0.45.2",
    "fflate": "^0.8.3",
    "html-encoding-sniffer": "^6.0.0",
