      "notes": [
        {
          "blockId": "spya-x6ys73",
          "kind": "tension",
          "text": "Here the English-to-French score is 41.0; the abstract and Table 2 give 41.8 for the same model and task.",
          "quote": "achieves a BLEU score of \\(41.0\\)",
          "to": "spya-r4309p",
          "toQuote": "new single-model state-of-the-art BLEU score of 41.8"
        },
        {
          "blockId": "spya-dyxt29",
          "kind": "explain",
          "text": "Relating two far-apart words takes more computing steps in those models the farther apart they are. The Transformer needs the same few steps regardless.",
          "quote": "grows in the distance between positions, linearly for ConvS2S and logarithmically for ByteNet",
          "to": null,
          "toQuote": null
        }
      ],
      "dropped": {
