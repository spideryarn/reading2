      "notes": [
        {
          "blockId": "spya-x6ys73",
          "kind": "tension",
          "text": "Here the English-to-French score is 41.0; the abstract and Table 2 give 41.8 for the same big model.",
          "quote": "achieves a BLEU score of \\(41.0\\)",
          "to": "spya-r4309p",
          "toQuote": "a new single-model state-of-the-art BLEU score of 41.8"
        },
        {
          "blockId": "spya-q59ey3",
          "kind": "tension",
          "text": "Twelve hours is the base model's time. The big model that sets the records took 3.5 days.",
          "quote": "as little as twelve hours on eight P100 GPUs",
          "to": "spya-rcuc7x",
          "toQuote": "The big models were trained for 300,000 steps (3.5 days)."
        }
      ],
      "dropped": {
