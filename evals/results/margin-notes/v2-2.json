      "notes": [
        {
          "blockId": "spya-x6ys73",
          "kind": "tension",
          "text": "Here the big model's English-to-French score is 41.0; the abstract and Table 2 give 41.8.",
          "quote": "achieves a BLEU score of \\(41.0\\)",
