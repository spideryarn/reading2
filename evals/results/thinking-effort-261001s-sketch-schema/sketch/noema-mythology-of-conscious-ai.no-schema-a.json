          "kind": "node",
          "id": "b2",
          "shape": "hex",
          "x": 260,
          "y": 140,
          "w": 180,
          "h": 80,
          "text": "Continuous, analogue, dynamical processes go beyond Turing-style algorithms",
          "size": "xs",
          "block": "spya-gr2k02"
