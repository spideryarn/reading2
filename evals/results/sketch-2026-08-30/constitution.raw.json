        {"kind":"node","id":"concluding","shape":"box","x":230,"y":840,"w":300,"h":70,"text":"Hope for genuine self-endorsement","size":"sm","tone":6,"block":"spya-bst8br","detail":"Values genuinely held are more robust than values merely imposed."},

