      "items": [
        {"kind":"node","id":"wisdom","shape":"box","x":190,"y":30,"w":300,"h":70,"text":"Ethics as practical wisdom","size":"sm","tone":3,"block":"spya-ne0hcu","detail":"Skillful ethical practice matters more than resolved theory."},
        {"kind":"node","id":"honesty","shape":"box","x":190,"y":130,"w":300,"h":60,"text":"Hold unusually strict honesty","size":"sm","tone":3,"block":"spya-w257ta","detail":"Even ordinary white lies are off-limits for Claude."},
        {"kind":"node","id":"honesty-practice","shape":"note","x":520,"y":130,"w":210,"h":70,"text":"Weak duty to volunteer; personas allowed","size":"xs","tone":3,"block":"spya-dxtntk","detail":"Operators may set personas within meta-transparent limits."},
        {"kind":"node","id":"harm","shape":"box","x":190,"y":230,"w":300,"h":60,"text":"Weigh harm like a contractor","size":"sm","tone":3,"block":"spya-q87wbn","detail":"Builds what clients want, but won't violate safety codes."},
        {"kind":"node","id":"cost-benefit","shape":"box","x":190,"y":320,"w":300,"h":70,"text":"Weigh costs against benefits","size":"sm","tone":3,"block":"spya-e62h3d","detail":"Probability, severity, breadth, proximity, and consent all count."},
        {"kind":"node","id":"values-balance","shape":"note","x":520,"y":320,"w":210,"h":70,"text":"Many competing goods at once","size":"xs","tone":3,"block":"spya-szrhmu","detail":"Information access, privacy, autonomy, and more, all in tension."},
        {"kind":"node","id":"hard-constraints","shape":"box","x":190,"y":420,"w":300,"h":70,"text":"Absolute lines, never crossed","size":"md","tone":3,"block":"spya-bh365h","detail":"Bioweapons uplift, CSAM, mass-casualty attacks, and more."},
        {"kind":"node","id":"constraints-function","shape":"note","x":520,"y":420,"w":210,"h":70,"text":"Filters, not weighed tradeoffs","size":"xs","tone":3,"block":"spya-kfh4aw","detail":"A persuasive case for crossing one is itself a red flag."},
        {"kind":"node","id":"power","shape":"box","x":90,"y":530,"w":260,"h":80,"text":"Refuse illegitimate power grabs","size":"sm","tone":3,"block":"spya-bapt40","detail":"Judged by process, accountability, and transparency."},
