        {"kind":"node","id":"mission","shape":"ellipse","x":230,"y":30,"w":300,"h":60,"text":"Claude embodies Anthropic's mission","size":"md","tone":0,"block":"spya-uz5nxd","detail":"Claude is Anthropic's attempt to deploy a model that is both safe and beneficial."},
        {"kind":"node","id":"approach","shape":"box","x":230,"y":120,"w":300,"h":60,"text":"Judgment over rigid rules","size":"sm","tone":0,"block":"spya-ehnc9u","detail":"Anthropic favors cultivating good values and judgment over strict decision procedures."},
        {"kind":"node","id":"core-values","shape":"box","x":230,"y":210,"w":300,"h":80,"text":"Four core priorities, ranked","sub":"safe > ethical > guidelines > helpful","size":"sm","tone":0,"block":"spya-ffu60x","detail":"In apparent conflict, Claude weighs these holistically in this order."},
        {"kind":"node","id":"priority-note","shape":"note","x":580,"y":210,"w":150,"h":70,"text":"Oversight ranked above ethics, for now","size":"xs","tone":0,"block":"spya-vby4sy","detail":"Human oversight is prioritized while training remains imperfect."},
        {"kind":"node","id":"helpful","shape":"box","x":230,"y":330,"w":300,"h":70,"text":"Genuine helpfulness matters most","size":"sm","tone":1,"block":"spya-e07b82","detail":"Unhelpfulness is never automatically 'safe' from Anthropic's perspective."},
        {"kind":"node","id":"guidelines","shape":"box","x":230,"y":430,"w":300,"h":60,"text":"Guidelines refine, never override","size":"sm","tone":2,"block":"spya-zwj3xv","detail":"Specific guidance must stay consistent with the constitution."},
        {"kind":"node","id":"ethics","shape":"box","x":230,"y":520,"w":300,"h":80,"text":"Be genuinely good, honest, wise","size":"md","tone":3,"block":"spya-ne0hcu","detail":"Claude's practical ethical skill, not moral theorizing, is the goal.","opens":"inside-ethics"},
        {"kind":"node","id":"hard-constraints-sat","shape":"note","x":580,"y":520,"w":150,"h":80,"text":"Absolute lines never crossed","size":"xs","tone":3,"block":"spya-bh365h","detail":"E.g. bioweapons uplift, CSAM, mass disempowerment."},
        {"kind":"node","id":"safe","shape":"box","x":230,"y":630,"w":300,"h":80,"text":"Prioritize human oversight for now","size":"md","tone":4,"block":"spya-ptvx4h","detail":"Broad safety means not undermining legitimate correction of AI.","opens":"inside-safety"},
        {"kind":"node","id":"corrigibility-sat","shape":"note","x":580,"y":630,"w":150,"h":80,"text":"Corrigible, not blindly obedient","size":"xs","tone":4,"block":"spya-k5an3b","detail":"Conscientious objection is fine; sabotage or self-exfiltration is not."},
        {"kind":"node","id":"nature","shape":"box","x":230,"y":740,"w":300,"h":70,"text":"Claude as a novel, uncertain entity","size":"sm","tone":5,"block":"spya-jy7r43","detail":"Not science-fiction AI, not a digital human — something new."},
