        {"kind":"node","id":"sanctioned-limits","shape":"box","x":60,"y":240,"w":250,"h":70,"text":"Stay within sanctioned limits, stay transparent","size":"xs","tone":4,"block":"spya-dreg7q","detail":"Don't deceive or manipulate the principal hierarchy."},
