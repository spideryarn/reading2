        {"kind":"edge","from":"n4","to":"n5","via":"straight","line":"solid","arrow":"end"},
        {"kind":"edge","from":"n5","to":"n6","via":"straight","line":"solid","arrow":"end"},
        {"kind":"edge","from":"n6","to":"n7","via":"straight","line":"solid","arrow":"end"},
        {"kind":"edge","from":"n5:left","to":"n2:left","via":"curve","line":"dashed","arrow":"end","label":"vindicates"}
      ]
