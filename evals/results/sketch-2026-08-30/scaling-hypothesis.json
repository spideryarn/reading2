{
  "version": "sketch/1",
  "title": "Scaling's Spine and Its Shadow",
  "caption": "A seven-step spine — evidence, theory, mechanism, politics, vindication — that ends by turning the same scaling logic on itself and finding it also breeds agency.",
  "scenes": [
    {
      "id": "overview",
      "title": "The Scaling Hypothesis",
      "height": 1160,
      "items": [
        {
          "kind": "region",
          "x": 24,
          "y": 40,
          "w": 712,
          "h": 410,
          "style": "band",
          "label": "THE CASE FOR SCALING",
          "tone": 1
        },
        {
          "kind": "region",
          "x": 24,
          "y": 460,
          "w": 712,
          "h": 280,
          "style": "band",
          "label": "WHO WILL ACT ON IT",
          "tone": 2
        },
        {
          "kind": "region",
          "x": 24,
          "y": 750,
          "w": 712,
          "h": 290,
          "style": "band",
          "label": "APPENDIX: DOES AGENCY EMERGE TOO?",
          "tone": 3
        },
        {
          "kind": "node",
          "id": "n1",
          "shape": "ellipse",
          "x": 230,
          "y": 80,
          "w": 300,
          "h": 90,
          "text": "GPT-3 arrives",
          "size": "md",
          "sub": "175B params, meta-learning appears",
          "detail": "A straightforward scale-up of GPT-2 unexpectedly learns to learn from examples alone.",
          "tone": 1,
          "block": "spya-dfggb3"
        },
        {
          "kind": "node",
          "id": "n2",
          "shape": "box",
          "x": 230,
          "y": 200,
          "w": 300,
          "h": 90,
          "text": "Scale alone breeds intelligence",
          "size": "md",
          "sub": "the blessings of scale, generalized",
          "detail": "Across vision, games, robotics, and language, bigger models+data+compute reliably yield generalization and meta-learning.",
          "tone": 1,
          "block": "spya-jwq3zr"
        },
        {
          "kind": "node",
          "id": "n3",
          "shape": "hex",
          "x": 230,
          "y": 320,
          "w": 300,
          "h": 90,
          "text": "Why pretraining works",
          "size": "md",
          "sub": "loss reduction tracks understanding",
          "detail": "Minimizing next-token loss forces a model from letter statistics toward genuine world-modeling.",
          "tone": 1,
          "block": "spya-ce0ts7"
        },
        {
          "kind": "node",
          "id": "n4",
          "shape": "diamond",
          "x": 230,
          "y": 510,
          "w": 300,
          "h": 90,
          "text": "Will anyone scale further?",
          "size": "md",
          "sub": "hardware is ready; will is not",
          "detail": "DeepMind and Google Brain have the compute but not the conviction to bet everything on scale.",
          "tone": 2,
          "block": "spya-b6zcpu"
        },
        {
          "kind": "node",
          "id": "n5",
          "shape": "box",
          "x": 230,
          "y": 630,
          "w": 300,
          "h": 90,
          "text": "Critics keep being wrong",
          "size": "md",
          "sub": "a decade of failed predictions",
          "detail": "Confident 'AI winter' forecasts from respected experts were repeatedly falsified by events.",
          "tone": 2,
          "block": "spya-bp9mm2"
        },
        {
          "kind": "node",
          "id": "n6",
          "shape": "box",
          "x": 230,
          "y": 800,
          "w": 300,
          "h": 90,
          "text": "Agency leaks in from data",
          "size": "md",
          "sub": "GPT-3 learns to roleplay agents",
          "detail": "Training on human-generated text inevitably teaches a model to imitate goal-pursuing agents.",
          "tone": 3,
          "block": "spya-hfcz8w",
          "opens": "inside-agency"
        },
        {
          "kind": "node",
          "id": "n7",
          "shape": "box",
          "x": 230,
          "y": 920,
          "w": 300,
          "h": 90,
          "text": "Even formal systems tempt it",
          "size": "md",
          "sub": "cellular automata, Turing machines",
          "detail": "Agency-like inference appears even when training on abstract rule systems with no agents at all.",
          "tone": 3,
          "block": "spya-myjtg3",
          "opens": "inside-agency"
        },
        {
          "kind": "node",
          "id": "n8",
