    {
      "id": "inside-pretraining",
      "title": "Why Does Pretraining Work",
      "height": 560,
      "items": [
        {
          "kind": "node",
          "id": "a",
          "shape": "ellipse",
          "x": 260,
          "y": 30,
          "w": 240,
          "h": 70,
          "text": "Prediction forces understanding",
          "size": "sm",
          "sub": "the pretraining thesis",
          "detail": "Humans emit text saturated with logic and causality; predicting it well requires learning those things.",
          "tone": 1,
          "block": "spya-ce0ts7"
        },
        {
          "kind": "node",
          "id": "b",
          "shape": "box",
          "x": 260,
          "y": 130,
          "w": 240,
          "h": 70,
          "text": "First: letters, words, spelling",
          "size": "sm",
          "sub": "rapid early gains",
          "detail": "Loss drops fast as the model learns letter frequencies, valid words, and simple word associations.",
          "tone": 1,
          "block": "spya-r465ug"
        },
        {
          "kind": "node",
          "id": "c",
          "shape": "box",
          "x": 260,
          "y": 230,
          "w": 240,
          "h": 70,
          "text": "Then: pronouns, coherence",
          "size": "sm",
          "sub": "errors shrink, get rarer",
          "detail": "Remaining errors become subtler and rarer, like keeping a character's gender pronoun consistent.",
          "tone": 1,
          "block": "spya-rz8jsm"
        },
        {
          "kind": "node",
          "id": "d",
          "shape": "box",
          "x": 260,
          "y": 330,
          "w": 240,
          "h": 70,
          "text": "The last bits are deepest",
          "size": "sm",
          "sub": "rare errors, real intelligence",
          "detail": "The final fractions of a bit of loss correspond to the rare, consequential judgments that most resemble intelligence.",
          "tone": 1,
          "block": "spya-kmyg3w"
        },
        {
          "kind": "node",
          "id": "f",
          "shape": "diamond",
          "x": 260,
          "y": 430,
          "w": 240,
          "h": 80,
          "text": "What will GPT-4 unlock?",
          "size": "sm",
          "sub": "no one can say",
          "detail": "Extrapolating the curve predicts roughly halved loss again, but no one knows what capability that buys.",
          "tone": 1,
          "block": "spya-uett4g"
        },
        {
          "kind": "node",
          "id": "e",
          "shape": "note",
          "x": 560,
          "y": 330,
          "w": 170,
          "h": 90,
          "text": "But is this provable in advance?",
          "size": "xs",
          "sub": "reasons for doubt",
          "detail": "Similar universal-learning arguments had failed before; only spending the compute actually proved it.",
          "tone": 2,
          "block": "spya-e5n86h"
        },
        {
          "kind": "edge",
          "from": "a",
          "to": "b",
          "via": "straight",
          "line": "solid",
          "arrow": "end"
        },
        {
