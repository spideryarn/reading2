      "title": "The Examples: Bugs Hiding in Plain Sight",
      "height": 900,
      "items": [
        {
          "kind": "node",
          "id": "e1",
          "shape": "box",
          "x": 260,
          "y": 30,
          "w": 260,
          "h": 70,
          "text": "3-state TM seems to compute n+1, fails at n=7",
