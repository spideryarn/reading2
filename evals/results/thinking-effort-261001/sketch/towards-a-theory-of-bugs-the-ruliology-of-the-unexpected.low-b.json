          "tone": 1,
          "block": "spya-rhc6t0"
        },
        {
          "kind": "node",
          "id": "e3",
          "shape": "box",
          "x": 260,
          "y": 230,
          "w": 260,
          "h": 70,
          "text": "A machine runs perfectly to n=14, fails at n=15",
