          "y": 90,
          "w": 300,
          "h": 70,
          "text": "Science learns to test ideas, discard failures",
          "size": "md",
          "detail": "Science arose from trying an idea and throwing it out if it didn't work; yet many still believe things that never work.",
          "tone": 1,
          "block": "spya-ddrr9m"
