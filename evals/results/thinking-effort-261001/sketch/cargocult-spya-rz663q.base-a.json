          "x": 230,
          "y": 560,
          "w": 300,
          "h": 80,
          "text": "Names it: Cargo Cult Science",
          "size": "md",
          "detail": "Like islanders who build fake runways and control towers, hoping planes land — the form of science without the substance that makes it work.",
          "tone": 2,
          "block": "spya-fd2muf"
        },
