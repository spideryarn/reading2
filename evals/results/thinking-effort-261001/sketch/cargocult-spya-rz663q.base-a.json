          "kind": "node",
          "id": "n8",
          "shape": "box",
          "x": 230,
          "y": 780,
          "w": 300,
          "h": 70,
          "text": "Careless work eventually gets exposed",
          "size": "sm",
          "tone": 2,
          "block": "spya-az6z7k"
        },
