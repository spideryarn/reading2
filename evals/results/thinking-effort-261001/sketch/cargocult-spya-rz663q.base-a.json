          "kind": "node",
          "id": "n10",
          "shape": "hex",
          "x": 230,
          "y": 1060,
          "w": 300,
          "h": 80,
          "text": "Rule one: you are easiest to fool",
          "size": "md",
          "detail": "The first principle of scientific integrity — after that, being honest with others is easy.",
          "tone": 3,
          "block": "spya-bvx2u8"
