          "id": "n7",
          "shape": "note",
          "x": 560,
          "y": 680,
          "w": 170,
          "h": 70,
          "text": "Unlike ads' true-but-misleading claims",
          "size": "sm",
          "tone": 2,
          "block": "spya-bpyx8n"
        },
