          "line": "solid",
          "arrow": "end"
        },
        {
          "kind": "edge",
          "from": "lang2",
          "to": "confab",
          "via": "straight",
          "line": "solid",
          "arrow": "end"
        },
        {
          "kind": "edge",
          "from": "confab",
          "to": "hype2",
          "via": "straight",
          "line": "solid",
          "arrow": "end"
        },
        {
          "kind": "edge",
          "from": "hype2",
          "to": "rapture",
          "via": "straight",
          "line": "solid",
          "arrow": "end"
        },
        {
          "kind": "edge",
          "from": "rapture",
