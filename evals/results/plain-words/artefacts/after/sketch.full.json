    {
      "id": "inside-temptations",
      "title": "Inside: Temptations To See Consciousness",
      "height": 1080,
      "items": [
        {
          "kind": "node",
          "id": "doing",
          "shape": "box",
          "x": 40,
          "y": 60,
          "w": 300,
          "h": 70,
          "text": "Intelligence is about doing",
          "size": "sm",
          "detail": "Solving puzzles, assembling furniture, walking to the shop - intelligence is judged by flexible goal-directed action.",
          "block": "spya-nj888h"
        },
        {
          "kind": "node",
          "id": "being",
          "shape": "box",
          "x": 420,
          "y": 60,
          "w": 300,
          "h": 70,
          "text": "Consciousness is about being",
          "size": "sm",
          "detail": "Philosopher Thomas Nagel: an organism is conscious if there is 'something it is like' to be that organism.",
          "block": "spya-j0a9rq"
        },
        {
          "kind": "node",
          "id": "chatgpt",
          "shape": "box",
          "x": 230,
          "y": 170,
          "w": 300,
          "h": 70,
          "text": "Is there something it's like to be ChatGPT?",
          "size": "sm",
          "detail": "AI clearly does things, but whether it experiences anything remains genuinely unclear.",
          "block": "spya-xm96be"
        },
        {
          "kind": "node",
          "id": "anthropocentrism",
          "shape": "box",
          "x": 40,
          "y": 290,
          "w": 320,
          "h": 70,
          "text": "Anthropocentrism: humans as the default",
          "size": "sm",
          "detail": "We take the human case as the definition of mind, rather than one example among many possible ones.",
          "block": "spya-h4mwb2"
        },
        {
          "kind": "node",
          "id": "exceptionalism",
          "shape": "box",
          "x": 400,
          "y": 290,
          "w": 320,
          "h": 70,
          "text": "Exceptionalism plus anthropomorphism",
          "size": "sm",
          "detail": "We rank humans above all else, then project human traits onto anything that superficially resembles us.",
          "block": "spya-her4zk"
        },
        {
          "kind": "node",
          "id": "imbue",
          "shape": "box",
          "x": 230,
          "y": 400,
          "w": 300,
          "h": 70,
          "text": "We imbue clever machines with minds",
          "size": "sm",
          "detail": "Once something acts intelligently, we readily assume it also understands and feels.",
          "block": "spya-nxxnrj"
        },
        {
          "kind": "node",
          "id": "lang2",
          "shape": "box",
          "x": 230,
          "y": 510,
          "w": 300,
          "h": 70,
          "text": "Fluent chatbots seem conscious",
          "size": "sm",
          "detail": "Language models get mistaken for minds far more often than equally complex non-verbal AI, like protein-folder AlphaFold.",
          "block": "spya-k6fpme"
        },
        {
          "kind": "node",
          "id": "confab",
          "shape": "box",
          "x": 230,
          "y": 620,
          "w": 300,
          "h": 70,
          "text": "'Hallucinate' implies feeling - try 'confabulate'",
          "size": "sm",
          "detail": "Calling AI errors 'hallucinations' quietly smuggles in the idea that the system has experiences to hallucinate.",
          "block": "spya-t29n67"
        },
        {
          "kind": "node",
          "id": "hype2",
          "shape": "box",
          "x": 230,
          "y": 730,
          "w": 300,
          "h": 70,
          "text": "Exponential growth feels like a turning point",
          "size": "sm",
          "detail": "On any exponential curve every point feels like the cusp of something huge - an illusion built into the math itself.",
          "block": "spya-cke6sj"
        },
        {
          "kind": "node",
          "id": "rapture",
          "shape": "box",
          "x": 230,
          "y": 840,
          "w": 300,
          "h": 70,
          "text": "Techno-rapture: the dream of digital godhood",
          "size": "sm",
          "detail": "Building a 'conscious' machine can feel like doing the work of gods, immortality in a silicon cloud included.",
          "block": "spya-v4sduf"
        },
        {
          "kind": "node",
          "id": "pareidolia",
          "shape": "box",
          "x": 230,
          "y": 950,
          "w": 300,
          "h": 70,
          "text": "Like seeing a face in a piece of toast",
          "size": "sm",
          "detail": "Naming this pattern-seeking bias is only the first step - it doesn't settle whether AI could ever really be conscious.",
          "block": "spya-k850tu"
        },
        {
