      "depth": 3,
      "parent": "n0101",
      "children": [
        "n0105"
      ],
      "range": [
        "spya-ynfe46",
        "spya-ynfe46"
      ],
      "title": "Saving and Overwork",
      "gist": "Prudent investment brings success, while overspending or overworking the body leads to breakdown and failure."
    },
    "n0105": {
      "id": "n0105",
      "depth": 4,
      "parent": "n0104",
