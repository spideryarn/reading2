        "spya-dxzfn8"
      ],
      "title": "Causes of Business Failure",
      "gist": "Business failure often stems from a mismatch between a person's mental organization and the work they attempt."
    },
    "n0092": {
      "id": "n0092",
      "depth": 3,
      "parent": "n0091",
      "children": [
        "n0093",
        "n0094"
      ],
      "range": [
        "spya-b5sg0c",
        "spya-r7gs4x"
      ],
      "title": "Imperfect Organization",
      "gist": "A person with feeble or unsuited faculties cannot succeed at demanding work no matter how hard they try."
    },
