        "n0067"
      ],
      "range": [
        "spya-y7fuv5",
        "spya-xytw0n"
      ],
      "title": "Phrenology in the Professions",
      "gist": "Artists, physicians, and clergymen can all improve their work by applying phrenological insight into human character and mind."
    },
    "n0053": {
      "id": "n0053",
      "depth": 2,
      "parent": "n0052",
      "children": [
        "n0054"
      ],
      "range": [
        "spya-y7fuv5",
        "spya-y7fuv5"
      ],
      "title": "Phrenology and Artists",
      "gist": "An artist who understands the mind's organization can paint character so faithfully that no label is needed to identify the subject."
    },
    "n0054": {
      "id": "n0054",
      "depth": 3,
      "parent": "n0053",
      "children": [
        "n0055"
      ],
      "range": [
        "spya-y7fuv5",
        "spya-y7fuv5"
      ],
      "title": "Painting True Character",
      "gist": "Knowledge of phrenology lets an artist capture a subject's real disposition and expression rather than a merely smooth, generic likeness."
    },
    "n0055": {
      "id": "n0055",
      "depth": 4,
      "parent": "n0054",
