    "n0016": {
      "id": "n0016",
      "depth": 1,
      "parent": "n0001",
      "children": [
        "n0017",
        "n0024"
      ],
      "range": [
        "spya-sgu686",
        "spya-g73szb"
      ],
      "title": "Physiology, Phrenology, and Self-Knowledge",
      "gist": "Phrenology extends physiology's lessons about bodily law into self-knowledge, explaining the mind's faculties and the differences among people."
    },
    "n0017": {
      "id": "n0017",
      "depth": 2,
      "parent": "n0016",
      "children": [
        "n0018",
        "n0021"
      ],
      "range": [
        "spya-sgu686",
        "spya-eks7rr"
      ],
      "title": "Physiology and Bodily Law",
      "gist": "Because the body is a delicate machine governed by fixed laws, people must know physiology to live healthily, and better teaching of it would strengthen children's constitutions."
    },
    "n0018": {
      "id": "n0018",
      "depth": 3,
      "parent": "n0017",
      "children": [
        "n0019",
        "n0020"
      ],
      "range": [
        "spya-sgu686",
        "spya-a3vnb6"
      ],
      "title": "Life as a Governed Machine",
      "gist": "Physiology gives the knowledge of life's laws needed to obey them, just as a machine must be understood to be properly managed."
    },
    "n0019": {
      "id": "n0019",
      "depth": 4,
      "parent": "n0018",
      "children": [],
      "range": [
        "spya-sgu686",
        "spya-sgu686"
      ],
      "title": ""
    },
    "n0020": {
