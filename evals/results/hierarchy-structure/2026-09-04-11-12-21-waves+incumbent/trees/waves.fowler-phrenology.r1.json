        "spya-ghg5yq",
        "spya-hq7xcd"
      ],
      "title": "Elements of Business Success",
      "gist": "Success in business depends on wise planning, careful management of resources, and recognizing the right moment."
    },
    "n0102": {
      "id": "n0102",
      "depth": 3,
      "parent": "n0101",
      "children": [
        "n0103"
      ],
      "range": [
        "spya-ghg5yq",
        "spya-ghg5yq"
      ],
      "title": "Planning versus Labour",
      "gist": "Some succeed through mental planning that directs the labour of others, while blind toil without purpose fails."
    },
    "n0103": {
      "id": "n0103",
      "depth": 4,
      "parent": "n0102",
      "children": [],
      "range": [
        "spya-ghg5yq",
