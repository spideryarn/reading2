      "children": [
        "n0107"
      ],
      "range": [
        "spya-hq7xcd",
        "spya-hq7xcd"
      ],
      "title": "Timing and Circumstance",
      "gist": "Success also requires recognizing the right moment, since even readiness must wait for its proper time."
    },
    "n0107": {
      "id": "n0107",
