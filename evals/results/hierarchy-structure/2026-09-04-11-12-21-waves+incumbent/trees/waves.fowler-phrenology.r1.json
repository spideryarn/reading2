    "n0021": {
      "id": "n0021",
      "depth": 3,
      "parent": "n0017",
      "children": [
        "n0022",
        "n0023"
      ],
      "range": [
        "spya-pjtqgn",
        "spya-eks7rr"
      ],
      "title": "Neglect and Educational Reform",
      "gist": "Ignorance of bodily laws stunts children's growth and vitality, so education must be reformed to teach physiology and build stronger constitutions."
    },
    "n0022": {
      "id": "n0022",
      "depth": 4,
      "parent": "n0021",
      "children": [],
      "range": [
        "spya-pjtqgn",
        "spya-pjtqgn"
      ],
      "title": ""
    },
    "n0023": {
