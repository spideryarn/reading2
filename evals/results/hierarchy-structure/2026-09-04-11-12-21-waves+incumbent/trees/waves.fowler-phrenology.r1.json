        "n0111"
      ],
      "range": [
        "spya-t44h4r",
        "spya-wjrymt"
      ],
      "title": "Purpose and Perfection",
      "gist": "Man's design gives every faculty a purpose, and true perfection lies in developing and rightly directing the whole mind."
    },
    "n0109": {
      "id": "n0109",
      "depth": 3,
      "parent": "n0108",
      "children": [
        "n0110"
      ],
      "range": [
        "spya-t44h4r",
        "spya-t44h4r"
      ],
      "title": "Man's Design and Purpose",
      "gist": "Man was made for a specific purpose, with every power meant for active, worthy use."
    },
    "n0110": {
