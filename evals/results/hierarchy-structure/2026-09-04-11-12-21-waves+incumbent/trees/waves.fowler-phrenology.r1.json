        "n0089"
      ],
      "range": [
        "spya-t8f80r",
        "spya-ne78jx"
      ],
      "title": "Character and Depravity",
      "gist": "Even great men have flaws, and outward virtue often masks inconsistent or self-serving conduct."
    },
    "n0087": {
      "id": "n0087",
      "depth": 3,
      "parent": "n0086",
      "children": [
        "n0088"
      ],
      "range": [
        "spya-t8f80r",
        "spya-t8f80r"
      ],
      "title": "Strength and Weakness",
      "gist": "A great man's very strength often carries the seed of his downfall, as with Napoleon."
    },
    "n0088": {
      "id": "n0088",
      "depth": 4,
      "parent": "n0087",
      "children": [],
