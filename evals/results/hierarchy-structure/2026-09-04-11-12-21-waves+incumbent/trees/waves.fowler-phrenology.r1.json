        "n0108"
      ],
      "range": [
        "spya-y546et",
        "spya-wjrymt"
      ],
      "title": "Character, Marriage, and Business Success",
      "gist": "Balanced or imbalanced faculties determine happiness, marital compatibility, moral conduct, and success or failure in business."
    },
    "n0081": {
      "id": "n0081",
      "depth": 2,
      "parent": "n0080",
      "children": [
        "n0082",
        "n0084"
      ],
      "range": [
        "spya-y546et",
        "spya-drpthy"
      ],
      "title": "Harmony of Faculties",
      "gist": "Genuine happiness and a successful marriage both depend on balancing the mind's faculties rather than indulging one at the expense of another."
    },
    "n0082": {
      "id": "n0082",
      "depth": 3,
      "parent": "n0081",
      "children": [
        "n0083"
      ],
      "range": [
        "spya-y546et",
        "spya-y546et"
      ],
      "title": "Balanced Faculties and Happiness",
      "gist": "True enjoyment comes from the harmonious exercise of all mental faculties, not from gratifying one while neglecting the others."
    },
    "n0083": {
      "id": "n0083",
      "depth": 4,
      "parent": "n0082",
      "children": [],
      "range": [
        "spya-y546et",
