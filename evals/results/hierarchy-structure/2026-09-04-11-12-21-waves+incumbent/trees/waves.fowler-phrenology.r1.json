      "children": [
        "n0085"
      ],
      "range": [
        "spya-drpthy",
        "spya-drpthy"
      ],
      "title": "Choosing a Marriage Partner",
      "gist": "Phrenology helps identify compatible partners, as shown by a cautionary tale of a marriage ruined by mismatched character."
    },
    "n0085": {
      "id": "n0085",
