        "n0060",
        "n0062"
      ],
      "range": [
        "spya-prrjgx",
        "spya-ft50z5"
      ],
      "title": "Phrenology and Physicians",
      "gist": "Physicians who grasp the mind's influence over the body can treat illness more effectively, a truth confirmed by both case histories and expert testimony."
    },
    "n0057": {
      "id": "n0057",
      "depth": 3,
      "parent": "n0056",
      "children": [
        "n0058",
        "n0059"
      ],
      "range": [
        "spya-prrjgx",
        "spya-gy8d5s"
      ],
      "title": "Mental Illness and the Body",
      "gist": "Cases of disappointment and grief show how mental states alone can prostrate or restore the body without any physical cause."
    },
