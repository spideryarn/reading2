      "range": [
        "spya-s2680p",
        "spya-dhj4jr"
      ],
      "title": "Friendship was invented in 18th-century Scotland",
      "gist": "Modern work gives people impersonal dignity and freer, less transactional relationships than relational societies ever could, which is why a more relational future, however natural, would be a real loss.",
      "question": "Why does impersonal work make relationships and dignity better, not worse? (a historical argument)",
      "sourceHeading": "Friendship was invented in 18th-century Scotland"
    },
    "n0082": {
      "id": "n0082",
      "depth": 2,
      "parent": "n0081",
      "children": [
        "n0083",
        "n0084",
        "n0085",
        "n0086"
      ],
      "range": [
        "spya-s2680p",
        "spya-zd83ts"
      ],
      "title": "Dignity through group membership",
      "gist": "Relational living is humanity's default and can be satisfying, but it ties personal dignity to group reputation, which explains why relational societies spend so much effort on gossip and status policing."
    },
