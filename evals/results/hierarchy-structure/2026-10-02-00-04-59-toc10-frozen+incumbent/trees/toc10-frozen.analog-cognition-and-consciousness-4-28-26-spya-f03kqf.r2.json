      ],
      "title": "Analog Computation with Waves",
      "gist": "Traveling waves may perform genuine analog computation, combining and interfering to generate new, energy-efficient brain states that support cognition and underlie the brain's unusually low power consumption.",
      "question": "Wave interactions — how could they perform actual computation rather than just organizing activity? (an analogy with analog machines)",
      "sourceHeading": "Analog Computation with Waves"
    },
    "n0080": {
