      ],
      "title": "Consciousness & Computation",
      "gist": "The belief that computation alone suffices for consciousness is a strong, under-examined assumption that looks increasingly implausible once we see how different brains are from computers.",
      "question": "Is computation enough for consciousness? (four arguments against)",
      "sourceHeading": "Consciousness & Computation"
    },
    "n0051": {
      "id": "n0051",
      "depth": 2,
