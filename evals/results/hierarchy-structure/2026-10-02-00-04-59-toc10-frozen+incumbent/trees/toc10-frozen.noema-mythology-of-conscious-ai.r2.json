      "range": [
        "spya-e7fdmb",
        "spya-d89xf7"
      ],
      "title": "What (Not) To Do?",
      "gist": "Given deep uncertainty about machine consciousness, nobody should try to create it, while conscious-seeming AI already poses serious, distinct ethical dangers we cannot easily escape.",
      "question": "What should we do given this uncertainty about conscious AI? (ethical recommendations)",
      "sourceHeading": "What (Not) To Do?"
    },
    "n0136": {
      "id": "n0136",
      "depth": 2,
      "parent": "n0135",
      "children": [
        "n0137",
