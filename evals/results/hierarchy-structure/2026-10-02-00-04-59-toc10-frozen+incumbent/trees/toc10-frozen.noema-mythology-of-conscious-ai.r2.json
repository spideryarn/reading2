      ],
      "title": "Fearing Artificial Minds",
      "gist": "Longstanding fears about artificial beings return with AI, and claims that chatbots are already conscious raise urgent stakes for both machines and ourselves.",
      "question": "Why does whether AI is conscious matter so much? (several reasons given)"
    },
