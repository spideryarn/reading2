      ],
      "range": [
        "spya-v98v5u",
        "spya-w8z40d"
      ],
      "title": "Soul Machine",
      "gist": "AI's social transformation should not be clouded by exaggerated claims of forthcoming conscious machines, and human meaning is better found in embodied, living awareness than in any disembodied soul or silicon rapture.",
      "question": "What matters more than the soul if machines cannot have one? (a closing reflection)",
      "sourceHeading": "Soul Machine"
    },
    "n0157": {
      "id": "n0157",
      "depth": 2,
      "parent": "n0156",
      "children": [
        "n0158",
