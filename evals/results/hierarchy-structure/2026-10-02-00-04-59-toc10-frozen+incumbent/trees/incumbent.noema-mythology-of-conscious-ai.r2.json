      ],
      "title": "What (Not) To Do?",
      "gist": "Given deep uncertainty, we should avoid deliberately creating conscious AI while taking seriously the separate dangers posed by AI that merely seems conscious.",
      "question": "How should we act given uncertainty about machine consciousness? (an ethical recommendation)",
      "sourceHeading": "What (Not) To Do?"
    },
    "n0135": {
      "id": "n0135",
      "depth": 2,
      "parent": "n0134",
      "children": [
