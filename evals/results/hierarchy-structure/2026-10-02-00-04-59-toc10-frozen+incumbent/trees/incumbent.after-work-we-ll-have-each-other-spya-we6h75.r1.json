      ],
      "title": "Friendship was invented in 18th-century Scotland",
      "gist": "Modern work supplies impersonal dignity and freedom that relational societies cannot, since status built only on group membership tends toward clannishness and exclusion.",
      "question": "work and friendship — why does paid work make relationships freer and fairer than relational societies allow? (a historical argument)",
      "sourceHeading": "Friendship was invented in 18th-century Scotland"
    },
    "n0085": {
      "id": "n0085",
