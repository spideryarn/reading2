      ],
      "title": "Consciousness & Computation",
      "gist": "The assumption that computation suffices for consciousness — computational functionalism — is deeply ingrained but likely wrong, as four arguments about brains, computation, life and simulation show.",
      "sourceHeading": "Consciousness & Computation"
    },
