      "range": [
        "spya-e7fdmb",
        "spya-d89xf7"
      ],
      "title": "What (Not) To Do?",
      "gist": "Given real uncertainty, nobody should deliberately create conscious AI, while conscious-seeming AI poses its own dangers through distorted moral concern and impenetrable illusions.",
      "sourceHeading": "What (Not) To Do?"
    },
    "n0130": {
      "id": "n0130",
      "depth": 2,
      "parent": "n0129",
      "children": [
