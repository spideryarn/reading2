      ],
      "title": "What (Not) To Do?",
      "gist": "Given deep uncertainty, nobody should set out to create conscious AI, and the nearer danger — machines that merely seem conscious — demands its own ethical care.",
      "sourceHeading": "What (Not) To Do?"
    },
    "n0129": {
      "id": "n0129",
      "depth": 2,
