      ],
      "title": "The Mythology Of Conscious AI",
      "gist": "Seth argues that psychological biases make us prone to imagine AI as conscious, but deep differences between computers and living brains mean real machine consciousness is unlikely, so we should worry more about the ethics of both creating conscious AI and misjudging AI that merely seems conscious.",
      "sourceHeading": "The Mythology Of Conscious AI"
    },
    "n0002": {
      "id": "n0002",
      "depth": 1,
      "parent": "n0001",
      "children": [
