      ],
      "title": "Consciousness & Computation",
      "gist": "The idea of conscious AI rests on computational functionalism, but four arguments — brains are not computers, other games in town, life matters, and simulation is not instantiation — all undermine it.",
      "sourceHeading": "Consciousness & Computation"
    },
    "n0046": {
      "id": "n0046",
      "depth": 2,
      "parent": "n0045",
