      ],
      "title": "The Mythology Of Conscious AI",
      "gist": "Anil Seth's prize-winning essay asks whether AI could be conscious and why our answer matters for machines, for us, and for how we understand human nature.",
      "sourceHeading": "The Mythology Of Conscious AI"
    },
