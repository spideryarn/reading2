      ],
      "title": "Consciousness & Computation",
      "gist": "Seth undermines computational functionalism with four arguments: brains are not computers, other non-algorithmic dynamics may matter, life may be necessary for consciousness, and simulation is not instantiation.",
      "sourceHeading": "Consciousness & Computation"
    },
    "n0049": {
