      ],
      "title": "What (Not) To Do?",
      "gist": "Given deep uncertainty, we should avoid deliberately creating conscious AI while urgently addressing the ethical dangers posed by conscious-seeming machines.",
      "sourceHeading": "What (Not) To Do?"
    },
    "n0132": {
      "id": "n0132",
      "depth": 2,
