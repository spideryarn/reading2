      ],
      "title": "The Mythology Of Conscious AI",
      "gist": "Anil Seth argues that psychological biases push us toward believing AI is conscious, but deep differences between brains and computers mean real machine consciousness is unlikely, so we must instead focus on the ethical risks of conscious-seeming AI.",
      "sourceHeading": "The Mythology Of Conscious AI"
    },
    "n0002": {
      "id": "n0002",
      "depth": 1,
      "parent": "n0001",
      "children": [
