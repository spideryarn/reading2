      ],
      "title": "5. PID in Action",
      "gist": "Applying PID to real neural recordings shows synergy concentrates in richly connected rich-club neurons, grows with recurrent connections and correlated inputs up to a point, and shifts with behavioral demands.",
      "question": "PID in action — where and why does synergistic computation concentrate in real neural circuits? (five empirical findings)",
      "sourceHeading": "5. PID in Action"
    },
