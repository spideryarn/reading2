      ],
      "range": [
        "spya-s2680p",
        "spya-t9qyhk"
      ],
      "title": "Reputation and group dignity",
      "gist": "Relational societies are humanity's default, but because personal dignity there depends on group membership, people constantly police each other's behavior to protect collective reputation rather than chase individual meaning."
    },
