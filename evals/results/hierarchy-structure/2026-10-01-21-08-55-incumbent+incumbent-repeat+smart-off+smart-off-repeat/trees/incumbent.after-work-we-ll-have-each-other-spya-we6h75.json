      ],
      "title": "Friendship was invented in 18th-century Scotland",
      "gist": "Work gives ordinary people impersonal respect and independence that relational societies cannot, since status based purely on group membership tends to become exclusionary and clannish rather than free.",
      "question": "Work and respect — why does paid work matter for dignity even though relational living is the historical norm? (survey and oral-history evidence)",
      "sourceHeading": "Friendship was invented in 18th-century Scotland"
    },
    "n0084": {
      "id": "n0084",
      "depth": 2,
