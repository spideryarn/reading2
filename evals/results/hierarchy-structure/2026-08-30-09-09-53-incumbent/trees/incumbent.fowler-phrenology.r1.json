        "n0038",
        "n0041",
        "n0045"
      ],
      "range": [
        "spya-v36sfm",
        "spya-qfc8sn"
      ],
      "title": "Self-Knowledge and Human Diversity",
      "gist": "Phrenology reveals each person's distinct mental strengths and weaknesses, explains natural variation among individuals, and shows how understanding one's capabilities enables growth within one's natural sphere."
    },
    "n0031": {
      "id": "n0031",
      "depth": 2,
      "parent": "n0030",
      "children": [
        "n0032",
        "n0033"
      ],
      "range": [
        "spya-v36sfm",
        "spya-ceaznc"
      ],
      "title": "Understanding One's Own Mind",
      "gist": "Phrenology grants self-knowledge by revealing the mind's discrete faculties and one's own particular strengths and weaknesses."
    },
    "n0032": {
      "id": "n0032",
      "depth": 3,
      "parent": "n0031",
