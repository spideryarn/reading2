      ],
      "title": "Oscillations organize neural information",
      "gist": "Oscillations organize spiking by phase, route information between regions, and separate feedforward from feedback processing by frequency, acting as active participants rather than byproducts of spiking.",
      "sourceHeading": "Oscillations organize neural information"
