      ],
      "title": "Friendship was invented in 18th-century Scotland",
      "gist": "Work gives us respect for impersonal skills and frees relationships from need, so losing it risks returning to clannish dependence, though the author hopes liberal individualism survives.",
      "question": "Work and meaning — why does work matter for dignity and for freer friendship?",
      "sourceHeading": "Friendship was invented in 18th-century Scotland"
    },
