      "range": [
        "spya-e7fdmb",
        "spya-d89xf7"
      ],
      "title": "What (Not) To Do?",
      "gist": "Because the theory is uncertain, nobody should try to build conscious AI, and AI that merely seems conscious is already a nearer and distinct ethical problem.",
      "question": "Conscious-seeming AI — how should we act given the uncertainty about machine consciousness? (a recommendation)",
      "sourceHeading": "What (Not) To Do?"
    },
    "n0133": {
      "id": "n0133",
      "depth": 2,
      "parent": "n0132",
