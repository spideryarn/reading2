      ],
      "title": "Soul Machine",
      "gist": "The future of AI is open, and conflating minds with machines shortchanges us, so we should recover an embodied sense of soul rooted in being alive.",
      "question": "Soul — what should we take our essence to be, if not a computable mind? (a closing reflection)",
      "sourceHeading": "Soul Machine"
    },
    "n0156": {
      "id": "n0156",
      "depth": 2,
