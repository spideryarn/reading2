      "title": "Oscillations as Control",
      "gist": "Brain waves actively shape spiking, and their electric fields reach many neurons at once and almost instantly, making them good candidates for rapid large-scale control.",
      "question": "Oscillations — how can brain waves directly influence spiking to control neurons? (a mechanism)"
    },
    "n0036": {
      "id": "n0036",
      "depth": 2,
      "parent": "n0035",
      "children": [
        "n0037",
        "n0038"
      ],
      "range": [
        "spya-jnp59d",
        "spya-trb3jf"
      ],
      "title": "Oscillations organize neural information",
      "gist": "Waves are rhythmic activity over millimeters to centimeters that organize spiking by phase, route information between regions, and separate feedforward from feedback signals, so they are not just a byproduct of spiking.",
      "sourceHeading": "Oscillations organize neural information"
    },
