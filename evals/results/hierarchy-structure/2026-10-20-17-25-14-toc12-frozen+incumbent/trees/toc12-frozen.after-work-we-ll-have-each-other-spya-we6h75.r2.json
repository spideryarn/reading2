      "range": [
        "spya-s2680p",
        "spya-dhj4jr"
      ],
      "title": "Friendship was invented in 18th-century Scotland",
      "gist": "People need respect from peers, and work supplies it through skills rather than birth, while modern labor markets loosened family ties and made freer friendship possible.",
      "question": "Work and dignity — why does work matter for meaning, and what would losing it cost? (an argument)"
    },
    "n0087": {
      "id": "n0087",
      "depth": 2,
      "parent": "n0086",
