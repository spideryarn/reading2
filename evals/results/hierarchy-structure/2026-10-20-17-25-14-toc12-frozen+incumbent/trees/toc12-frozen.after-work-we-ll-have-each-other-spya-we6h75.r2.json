        "n0090"
      ],
      "range": [
        "spya-s2680p",
        "spya-qsfkqr"
      ],
      "title": "Relational living and reputation",
      "gist": "Relational societies are natural and common, but because the group's reputation is everyone's dignity, people spend their energy on gossip and norm enforcement."
    },
