      ],
      "range": [
        "spya-hbueqc",
        "spya-vnkr36"
      ],
      "title": "An open, chosen future",
      "gist": "AI's future is not predetermined by science fiction or corporate narrative, and mistaking our algorithms for ourselves, or ourselves for algorithms, risks overestimating machines while underestimating human richness."
    },
