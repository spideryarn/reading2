      ],
      "title": "4: Simulation Is Not Instantiation",
      "gist": "Simulating a brain's processes on a computer does not create the real thing, just as simulating digestion does not digest food, so brain uploads and simulated universes rest on an unproven assumption.",
      "sourceHeading": "4: Simulation Is Not Instantiation"
    },
    "n0116": {
      "id": "n0116",
      "depth": 3,
      "parent": "n0115",
      "children": [
