      ],
      "title": "2: Other Games In Town",
      "gist": "Many real systems, from steam engine governors to brains, are best understood through continuous, physical dynamics rather than through step-by-step algorithms, widening what might matter for consciousness.",
      "sourceHeading": "2: Other Games In Town"
    },
    "n0082": {
      "id": "n0082",
      "depth": 3,
      "parent": "n0081",
