      ],
      "title": "What (Not) To Do?",
      "gist": "Given deep uncertainty about machine consciousness, we should not try to create it, but must still handle the near-term danger of AI that merely seems conscious.",
      "question": "How should we act given uncertainty about machine consciousness? (a recommendation)",
      "sourceHeading": "What (Not) To Do?"
    },
