      "range": [
        "spya-gm3xu0",
        "spya-gm3xu0"
      ],
      "title": "AI as escape valve",
      "gist": "AI now lets people avoid writing entirely, in both school and work, dissolving the old pressure to learn."
    },
    "n0018": {
      "id": "n0018",
      "depth": 3,
      "parent": "n0017",
      "children": [],
