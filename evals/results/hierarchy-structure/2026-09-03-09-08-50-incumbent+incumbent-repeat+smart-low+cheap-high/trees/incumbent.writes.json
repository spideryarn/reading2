      ],
      "title": "Pressure to write, and its escape valve",
      "gist": "Writing pervades prestigious work, and the pressure this creates once forced everyone to learn to write, but AI now offers an easy way out."
    },
    "n0014": {
      "id": "n0014",
      "depth": 2,
      "parent": "n0013",
      "children": [
        "n0015",
        "n0016"
      ],
      "range": [
        "spya-xdmpa0",
        "spya-zzw20p"
      ],
      "title": "The pressure to write",
      "gist": "The conflict between the expectation to write and the difficulty of doing it well drives even eminent people to plagiarize petty boilerplate."
    },
    "n0015": {
      "id": "n0015",
      "depth": 3,
      "parent": "n0014",
      "children": [],
