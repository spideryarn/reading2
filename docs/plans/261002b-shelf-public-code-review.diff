+
+afterEach(() => {
+  act(() => root.unmount());
+  host.remove();
+});
+
+async function show(path: string) {
+  history.replaceState(null, "", path);
+  host = document.createElement("div");
+  document.body.append(host);
+  root = createRoot(host);
+  await act(async () => {
