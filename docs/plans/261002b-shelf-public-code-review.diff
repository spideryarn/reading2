+}));
+vi.mock("../src/web/FeedbackButton.js", () => ({ FeedbackTrigger: () => null }));
+vi.mock("../src/web/useSession.js", () => ({
+  useSession: () => ({ session: null, user: null, loading: false }),
+}));
+
