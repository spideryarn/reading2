diff --git a/src/citer-link.ts b/src/citer-link.ts
index 05eaa0805..5ed241d67 100644
--- a/src/citer-link.ts
+++ b/src/citer-link.ts
@@ -23,3 +23,15 @@ export function citerUrl(citer: { doi?: string; openalexId: string }): string |
   if (citer.doi !== undefined) return doiUrl(citer.doi);
   return OPENALEX_WORK_ID.test(citer.openalexId) ? `https://openalex.org/${citer.openalexId}` : null;
 }
+
+/**
+ * **OpenAlex's own page for a full-text search**, the *See all* link under
+ * *Possible citations* (plan 261026f): the same phrase and the same first year
+ * as the count beside it. The phrase is ours, made from the article's title by
+ * `fulltextPhraseOf`, and goes in as one encoded parameter, so it cannot add a
+ * filter or change the address.
+ */
+export function openAlexFulltextPageUrl(phrase: string, fromYear: number | null): string {
+  const range = fromYear === null ? "" : `,publication_year:>${fromYear - 1}`;
+  return `https://openalex.org/works?${new URLSearchParams({ filter: `fulltext.search:"${phrase}"${range}` }).toString()}`;
+}
