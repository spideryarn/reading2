+  useReaderTranscriber: () => async () => {
+    throw new Error("not called");
+  },
+}));
+
+const { CommentDialog } = await import("../src/web/CommentDialog.js");
+
+const COMMENT: ClientComment = {
+  id: "spya-p7w2dn",
+  blockId: "spya-k3m9qt",
+  quote: "a science of bumps",
+  start: 0,
+  createdAt: "2026-09-05T10:00:00.000Z",
+  body: "stored words",
+  status: "none",
+};
