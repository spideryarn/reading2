+
+let container: HTMLDivElement;
+let root: Root;
+let edits: Array<string | null>;
+let closes: number;
+let touches: number;
+
+beforeEach(() => {
+  mic.state.clear();
+  mic.options.clear();
+  edits = [];
+  closes = 0;
+  touches = 0;
