+  const real = await importOriginal<typeof import("../src/messages-stream.js")>();
+  return {
+    ...real,
+    streamMessage: (task: string, body: unknown) => {
+      sent.push({ task, body: JSON.parse(JSON.stringify(body)) });
+      const message = {
+        id: "msg_stub",
+        type: "message",
+        role: "assistant",
