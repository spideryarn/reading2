+  if (held.length !== fetched.length) return false;
+  return held.every((a, i) => {
+    const b = fetched[i];
+    return (
+      b !== undefined &&
+      a.id === b.id &&
+      a.kind === b.kind &&
+      a.tag === b.tag &&
+      a.level === b.level &&
+      a.text === b.text &&
+      a.gistable === b.gistable &&
+      a.role === b.role &&
+      a.treatment === b.treatment
+    );
+  });
+}
