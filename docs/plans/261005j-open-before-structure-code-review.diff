 import { MODES, modeFromParam, RETIRED_MODES } from "../src/modes.js";
 import { readMode } from "../src/read-address.js";
 import { structureColumnsBand } from "../src/web/layout.js";
+import { STRUCTURE_ARRIVING } from "../src/messages.js";
