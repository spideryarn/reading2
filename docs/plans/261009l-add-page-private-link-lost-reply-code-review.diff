+    io.read = () => new Promise((resolve) => (readBack = resolve));
+    link.recheck();
+    expect(link.get()).toEqual({ kind: "unknown", because: "write", checking: true });
+    link.turnOff();
+    await vi.runAllTimersAsync();
+    expect(link.get()).toEqual({ kind: "off" });
