+      <circle className="share-pie-whole" r={R} />
+      {slice.kind === "full" && <circle className="share-pie-part" r={R} />}
+      {slice.kind === "slice" && <path className="share-pie-part" d={slice.d} />}
+    </svg>
+  );
+}
