+
+loadEnvLocal();
+
+const ROOT = path.resolve(import.meta.dirname, "..");
+const FROM = "writes";
+const SLUG = "test-block-roles-pg";
+
+const { reachable } = await pgReady({
+  suite: "tests/store-block-roles-pg.test.ts",
+  tables: ["spideryarn.revision_blocks"],
+});
