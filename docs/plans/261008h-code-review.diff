+  "vitest.config.ts",
+  "vitest-admission.ts",
+  "admission-journal.ts",
+  "tsconfig.json",
+  "tsconfig.base.json",
+  "scripts/vitest-outcome-reporter.ts",
+  "scripts/db-test-create.ts",
