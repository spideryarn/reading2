+  });
+});
+
+/* ---- the deploy's own records ---- */
+
+const deployRecord = (over: Partial<DeployRunRecord> = {}): string =>
+  JSON.stringify({
+    schema: 2,
+    by: "deploy-gate",
+    runId: "spideryarn-deploy-abc-cccccccc",
+    sha: C,
+    root: "/tmp/spideryarn-deploy-abc/tree",
+    startedAt: new Date(NOW - 2 * HOUR).toISOString(),
