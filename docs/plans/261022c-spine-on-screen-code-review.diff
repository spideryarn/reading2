+.spine-veil-track {
+  position: absolute;
+  inset: 0;
+  pointer-events: none;
+  will-change: transform;
+}
+.spine-veil-track::before,
+.spine-veil-track::after {
+  content: "";
+  position: absolute;
+  left: 0;
+  right: 0;
+  height: 100%;
+  background: color-mix(in oklab, var(--panel) var(--spine-veil), transparent);
+}
+.spine-veil-track::before { bottom: 100%; }
+.spine-veil-track::after { top: max(var(--view-h), 2px); }
+/* How much of the panel the veil mixes in: by eye in both appearances, so
+   that the lit stretch is plain at a glance and the reading chart's faint area
+   still reads through it off screen. The dark panel swallows less of a tint
+   than the light one, so it needs more. */
+.spine { --spine-veil: 50%; }
+:root[data-theme="light"] .spine { --spine-veil: 40%; }
+
+@media (prefers-contrast: more) {
+  .spine { --spine-veil: 65%; }
+  :root[data-theme="light"] .spine { --spine-veil: 60%; }
+  .spine-viewport { border-width: 2px; }
