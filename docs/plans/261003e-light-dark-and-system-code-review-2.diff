++      const end = src.indexOf("*/", i + 2);
++      const stop = end === -1 ? src.length : end + 2;
++      out += src.slice(i, stop).replace(/[^\n]/g, " ");
++      i = stop;
++      continue;
++    }
++    if (c === "/" && next === "/") {
++      const end = src.indexOf("\n", i);
++      const stop = end === -1 ? src.length : end;
++      out += " ".repeat(stop - i);
