+      const [reservation] = await tx
+        .insert(ingestEvents)
+        .values({ ownerId, kind: "minimal", ...(options.slug ? { slug: options.slug } : {}) })
+        .returning({ id: ingestEvents.id });
+      if (!reservation) throw new Error("reserving a minimal paper returned no row");
