+    expect(await reserveUpgrade(OWNER, theirs)).toEqual({ kind: "not-found" });
+    const { rows } = await pool.query("select 1 from spideryarn.billing_accounts where owner_id = $1", [OWNER]);
+    expect(rows).toHaveLength(0);
