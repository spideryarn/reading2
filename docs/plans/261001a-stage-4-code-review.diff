+/** A DOI's characters, anchored — the continuation `entryIdentifiers` may append. */
+const DOI_CHARS = /^[^\s"'<>?#]+/;
+/** `DOI`, but letting the suffix be empty: a line may break straight after the slash. */
+const DOI_OPEN = /\b(10\.\d{4,9}\/[^\s"'<>?#]*)/gi;
+
+/**
+ * **Every DOI and arXiv id in a PDF reference-list entry**, or `"unreadable"`
+ * when one is there but its end cannot be told (plan 261001a stage 4).
+ *
+ * The entry is the text layer's lines joined and whitespace-collapsed
+ * (`numberedEntries` in src/citation-reference-list.ts), so a line break is
+ * now a single space, and `dehyphenate` has already joined `neu-\nron` (a
+ * lowercase letter after the hyphen) into `neuron`. That join is taken as the
+ * typesetter's; a DOI whose own hyphen fell there loses it, and nothing in the
+ * text can say so — stage 5's title check against the registry is the guard.
+ * What is left to judge:
+ *
+ * - **A DOI that ends in `-`, `/` or `_` before a space** cannot have ended
+ *   there — `10.1111/j.1467- 9280…`, `10.1038/ s41586-…` — so the next run of
+ *   characters is its continuation, and is joined on.
+ * - **A DOI followed by a space and a lowercase-or-digit run with no colon**
+ *   (`10.1016/j.cell. 2020.01.001`) may have been cut by the line break or may
+ *   have ended: no way to tell, so the entry is `"unreadable"` and its row keeps
+ *   its search. A capital after it (`… Accessed`), a bracket, a comma, or a
+ *   colon-bearing token (`arXiv:…`, `https://…`) is a DOI that ended; a
+ *   trailing sentence period is stripped (`trimDoi`).
+ * - **An arXiv id followed by a digit**, with or without a space between, was
+ *   cut short, and is `"unreadable"` likewise.
+ *
+ * A wrong identifier is worse than a search, so every doubt gives up.
+ */
+export function entryIdentifiers(entry: string): { dois: string[]; arxivs: string[] } | "unreadable" {
+  const dois = new Map<string, string>();
+  for (const m of entry.matchAll(DOI_OPEN)) {
+    let raw = m[1] ?? "";
+    let end = (m.index ?? 0) + m[0].length;
+    for (;;) {
+      if (!/[-/_]$/.test(raw)) break;
+      const next = /^\s(?=\S)/.test(entry.slice(end)) ? DOI_CHARS.exec(entry.slice(end + 1)) : null;
+      if (!next) break;
+      raw += next[0];
+      end += 1 + next[0].length;
+    }
+    const doi = trimDoi(raw);
+    if (!doi || doi.endsWith("/")) continue;
+    const tail = raw.slice(doi.length);
+    if ((tail === "" || tail === ".") && /^\s[\p{Ll}\d][^\s:]*(?=\s|$)/u.test(entry.slice(end))) {
+      return "unreadable";
+    }
+    dois.set(doi.toLowerCase(), doi);
+  }
+  const arxivs = new Set<string>();
+  for (const pattern of [ARXIV_URL, ARXIV_TEXT]) {
+    for (const m of entry.matchAll(pattern)) {
+      if (!m[1]) continue;
+      if (/^\s?\d/.test(entry.slice((m.index ?? 0) + m[0].length))) return "unreadable";
+      arxivs.add(m[1].toLowerCase());
+    }
+  }
+  return { dois: [...dois.values()], arxivs: [...arxivs] };
+}
