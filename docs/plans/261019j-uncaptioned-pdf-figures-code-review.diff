+    const first = marker(3, 1);
+    const second = marker(3, 2);
+    const shared = (index: number) => neighbours({ run: { index, of: 2 } });
+    const { locate } = scriptedLocator([FIGURE_1_ON_PAGE_3, { page: null, box_2d: null }]);
