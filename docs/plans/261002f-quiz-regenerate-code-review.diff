diff --git a/tests/quiz-regenerate-holds-until-the-new-batch.test.tsx b/tests/quiz-regenerate-holds-until-the-new-batch.test.tsx
new file mode 100644
index 000000000..f15a3e90a
--- /dev/null
+++ b/tests/quiz-regenerate-holds-until-the-new-batch.test.tsx
@@ -0,0 +1,113 @@
+// @vitest-environment jsdom
+/**
+ * **Regenerate stays held until the replacement quiz has been read** — GPT
+ * Sol's plan review of docs/plans/261002f-quiz-regenerate-for-my-profile.md.
+ *
+ * `job` and `starting` cover the press and the run. They do not cover the gap
+ * after: a finished job leaves `job` before the re-read lands, and a re-read
+ * that fails keeps the old batch *and its old `profileChanged: true`*, so the
+ * badge would offer a second paid rewrite. `useQuiz.rewriting` is that gap: on
+ * from the press, off when a new batch arrives or the job fails or is
+ * cancelled (both are `failed`).
+ */
+import { act, createElement } from "react";
+import { createRoot, type Root } from "react-dom/client";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import type { Quiz } from "../src/types.js";
+import type { QuizRead, UseQuiz } from "../src/web/useQuiz.js";
+
+(globalThis as { IS_REACT_ACT_ENVIRONMENT?: boolean }).IS_REACT_ACT_ENVIRONMENT = true;
+
+/** The job hook, posed: what `useQuiz` reads of it, and nothing more. */
+let failed: { message: string } | null = null;
+const started: unknown[] = [];
+vi.mock("../src/web/useStepJob.js", () => ({
+  useStepJob: () => ({
+    job: null,
+    failed,
+    starting: false,
+    stalled: false,
+    start: async (opts: unknown) => {
+      started.push(opts);
+    },
+    cancel: () => {},
+  }),
+}));
+vi.mock("../src/web/useAutoRun.js", () => ({ useAutoRun: () => {} }));
+
+const { useQuiz } = await import("../src/web/useQuiz.js");
+
+const quizOf = (batchId: string) => ({ batchId, questions: [] }) as unknown as Quiz;
+
+function read(batchId: string): QuizRead {
+  return {
+    status: "ready",
+    quiz: quizOf(batchId),
+    stale: false,
+    outdated: false,
+    profiled: true,
+    profileChanged: true,
+    error: null,
+    reload: async () => {},
+    refresh: async () => {},
+  };
+}
+
+let host: HTMLDivElement;
+let root: Root;
+let owner: UseQuiz | null = null;
+
+function Probe({ r }: { r: QuizRead }) {
+  owner = useQuiz("a-piece", r);
+  return null;
+}
+const paint = (r: QuizRead) => act(() => root.render(createElement(Probe, { r })));
+
+beforeEach(() => {
+  failed = null;
+  started.length = 0;
+  owner = null;
+  host = document.createElement("div");
+  document.body.append(host);
+  root = createRoot(host);
+});
+
+afterEach(() => {
+  act(() => root.unmount());
+  host.remove();
+});
+
+describe("rewriting", () => {
+  it("is off before anything is pressed", () => {
+    paint(read("spya-batcha"));
+    expect(owner?.rewriting).toBe(false);
+  });
+
+  it("stays on after the press while the old batch is still the one on screen", async () => {
+    const r = read("spya-batcha");
+    paint(r);
+    await act(async () => owner?.write());
+    expect(started).toEqual([{ force: true }]);
+    /* The job has come and gone (`job` is null throughout here) and the re-read
+       has not brought a new batch: exactly the window that offered a second
+       paid press. */
+    paint({ ...r });
+    expect(owner?.rewriting).toBe(true);
+  });
+
+  it("goes off when the replacement batch arrives", async () => {
+    paint(read("spya-batcha"));
+    await act(async () => owner?.write());
+    paint(read("spya-batchb"));
+    expect(owner?.rewriting).toBe(false);
+  });
+
+  it("goes off when the job failed or was cancelled, so the reader can try again", async () => {
+    const r = read("spya-batcha");
+    paint(r);
+    await act(async () => owner?.write());
+    failed = { message: "Stopped." };
+    paint({ ...r });
+    expect(owner?.rewriting).toBe(false);
+  });
+});
