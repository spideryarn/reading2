+  it("comes out as ordinary visible prose", async () => {
+    const run = (props: string, text: string) => `<w:p><w:r><w:rPr>${props}</w:rPr><w:t>${text}</w:t></w:r></w:p>`;
+    const got = await convertUpload(
+      "docx",
+      docx(
+        run('<w:color w:val="FFFFFF"/>', "WHITE-TEXT") +
