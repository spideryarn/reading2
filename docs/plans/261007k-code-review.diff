+   * swallowed it would drop the work and report success.
+   */
+  it("still treats an add that asks for forced steps as work", async () => {
+    await publishedAt("forced");
+    const reply = await post("/api/jobs", { url: `${HOST}/forced`, force: ["fetch"] });
