index 41003bf53..fcab3b41b 100644
--- a/tests/touch-controls.test.ts
+++ b/tests/touch-controls.test.ts
@@ -392,3 +392,93 @@ describe("a text field iOS must not zoom into", () => {
     expect(offenders).toEqual([]);
