+  });
+
+  it("counts a fragment link at 0.3 of its length", () => {
+    const fragment = `<a href="#ref-1">a source link that is fairly long</a>`;
+    expect(readabilityWouldTakeItForItsLinks(div(`<div class="c">${figure(fragment)}</div>`))).toBe(false);
