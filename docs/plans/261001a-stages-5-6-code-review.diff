+    source: v.source,
+    title,
+    authors,
+    ...(typeof more === "number" && Number.isInteger(more) && more > 0 ? { moreAuthors: more } : {}),
+    ...(typeof year === "number" && Number.isInteger(year) && year >= 1500 && year <= 2100 ? { year } : {}),
+    ...(venue !== null ? { venue } : {}),
+  };
