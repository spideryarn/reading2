+  const name = fileName(src);
+  for (const label of [alt.trim(), name]) {
+    if (AT_IMAGE.test(label)) return " [at] ";
+    if (DOT_IMAGE.test(label)) return " [dot] ";
+  }
+  return ` [image: ${(alt.trim() || name).slice(0, 60)}] `;
