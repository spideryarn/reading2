+-- 2. The constraints, renamed where drizzle-kit would have dropped and re-made
+--    them. The names now match src/db/schema.ts and the snapshot beside this
+--    file.
+ALTER TABLE "spideryarn"."referee_promises" RENAME CONSTRAINT "referee_claims_pkey" TO "referee_promises_pkey";--> statement-breakpoint
+ALTER TABLE "spideryarn"."referee_promises" RENAME CONSTRAINT "referee_claims_status" TO "referee_promises_status";--> statement-breakpoint
+ALTER TABLE "spideryarn"."referee_promises" RENAME CONSTRAINT "referee_claims_empty_unless_done" TO "referee_promises_empty_unless_done";--> statement-breakpoint
+ALTER TABLE "spideryarn"."referee_promises" RENAME CONSTRAINT "referee_claims_article_id_articles_id_fk" TO "referee_promises_article_id_articles_id_fk";--> statement-breakpoint
+ALTER TABLE "spideryarn"."referee_promises" RENAME CONSTRAINT "referee_claims_owner_fk" TO "referee_promises_owner_fk";--> statement-breakpoint
+
+-- 3. The old name, as a view with the old column names. Every column listed
+--    and each a plain reference, so it is automatically updatable and an
+--    `INSERT` through it that leaves a column out (or says `default`) takes the
+--    table's default (`promises`' `'[]'`, `created_at`'s now).
+CREATE VIEW "spideryarn"."referee_claims" AS
+  SELECT "article_id",
+         "owner_id",
+         "status",
+         "promises" AS "claims",
+         "model",
+         "promises_omitted" AS "claims_omitted",
+         "error",
+         "created_at",
+         "source_hash",
+         "attempt_id",
+         "finished_at"
+    FROM "spideryarn"."referee_promises";--> statement-breakpoint
+
+-- The view's grants are the table's, copied rather than written out, exactly
+-- as drizzle/20261010063350_reception_expand.sql does for its view: the app
+-- role reads and writes through the default privileges docs/project/database.md
+-- § Step three sets (which a view created by the same owner also gets), and
+-- this copies the table's direct grants to roles other than its owner and
+-- PUBLIC — production's app-role DML grants are the case it is for.
+DO $$
+DECLARE
+  g record;
+BEGIN
+  FOR g IN
+    SELECT pg_get_userbyid(a.grantee) AS grantee, a.privilege_type
+      FROM pg_class c, aclexplode(c.relacl) a
+     WHERE c.oid = '"spideryarn"."referee_promises"'::regclass
+       AND a.grantee <> c.relowner
+       AND a.grantee <> 0
+  LOOP
+    EXECUTE format('GRANT %s ON "spideryarn"."referee_claims" TO %I', g.privilege_type, g.grantee);
+  END LOOP;
+END $$;--> statement-breakpoint
+
+-- **The postcondition**, because a rename that missed and one that worked print
+-- the same tick: the old name answers with every row, and every constraint
+-- carries the new name.
+DO $$
+DECLARE through_view bigint;
+DECLARE in_table bigint;
+DECLARE old_names bigint;
+BEGIN
+  SELECT count(*) INTO through_view FROM "spideryarn"."referee_claims";
+  SELECT count(*) INTO in_table FROM "spideryarn"."referee_promises";
+  SELECT count(*) INTO old_names
+    FROM pg_constraint
+   WHERE conrelid = '"spideryarn"."referee_promises"'::regclass
+     AND conname LIKE 'referee\_claims\_%';
+  IF through_view <> in_table OR old_names > 0 THEN
+    RAISE EXCEPTION
+      'migration referee_promises: % row(s) through the view against % in the table, and % constraint(s) still named referee_claims_*',
+      through_view, in_table, old_names;
+  END IF;
+END $$;
