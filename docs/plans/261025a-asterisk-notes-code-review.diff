+  notes: readonly PdfNote[],
+  blocks: readonly RenderBlock[],
+  pieces: readonly { block: number; page: number; start: number; end: number }[],
+  claimed: ReadonlySet<string>,
+  pageTexts: ReadonlyMap<number, string> | undefined,
