+/** A contents list with no label links to at least this many distinct headings. */
+export const LINKED_CONTENTS_MIN_ENTRIES = 3;
+
+/** The in-page targets of a block's links: `href="#…"`, as blocks rewrote them to block ids. */
+const IN_PAGE_HREF = /\bhref="#([^"]+)"/gu;
+
+/**
+ * **Tables of contents with no label** (plan 261024h): runs of short text
+ * blocks, empty blocks allowed between, each linking to a heading of the
+ * article that comes after it, together naming at least
+ * `LINKED_CONTENTS_MIN_ENTRIES` distinct headings. The link is the evidence:
+ * a "Key points" list whose lines happen to repeat later headings has none,
+ * and stays showing (front-and-back-matter.md: never folded). Where a run
+ * sits is the caller's to check, and the shared checks still hold it to its
+ * entries naming the headings (`stretchEvidence`'s unlabelled contents).
+ * `[start, end)`, ending at the last entry.
+ */
+export function linkedContentsRuns(blocks: readonly Block[]): { start: number; end: number }[] {
+  const headingAt = new Map<string, number>();
+  blocks.forEach((b, i) => {
+    if (b.kind === "heading") headingAt.set(b.id, i);
+  });
+  const runs: { start: number; end: number }[] = [];
+  let start = -1;
+  let last = -1;
+  let named = new Set<string>();
+  const close = () => {
+    if (start >= 0 && named.size >= LINKED_CONTENTS_MIN_ENTRIES) runs.push({ start, end: last + 1 });
+    start = -1;
+    named = new Set();
+  };
+  for (let i = 0; i < blocks.length; i++) {
+    const b = blocks[i]!;
+    if (b.words === 0 && b.kind !== "heading") continue;
+    const target =
+      b.kind === "text" && b.words <= CONTENTS_MAX_ENTRY_WORDS
+        ? [...b.html.matchAll(IN_PAGE_HREF)].map((m) => m[1]!).find((id) => (headingAt.get(id) ?? -1) > i)
+        : undefined;
+    if (target === undefined) {
+      close();
+      continue;
+    }
+    if (start < 0) start = i;
+    named.add(target);
+    last = i;
+  }
+  close();
+  return runs;
+}
